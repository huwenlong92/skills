#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR"

REPO_URL="${GITHUB_PUBLIC_REPO_URL:-}"
BRANCH="${GITHUB_PUBLIC_BRANCH:-main}"
DRY_RUN="${DRY_RUN:-0}"
TMP_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 1
  fi
}

need git

if [ -z "$REPO_URL" ]; then
  echo "GITHUB_PUBLIC_REPO_URL must name the confirmed public-page repository" >&2
  exit 1
fi
if [ "$DRY_RUN" != "0" ] && [ "$DRY_RUN" != "1" ]; then
  echo "DRY_RUN must be 0 or 1" >&2
  exit 1
fi
git check-ref-format --branch "$BRANCH" >/dev/null

if [ ! -f "$ROOT_DIR/README.public.md" ]; then
  echo "missing README.public.md" >&2
  exit 1
fi

if [ -L "$ROOT_DIR/README.public.md" ]; then
  echo "README.public.md must not be a symlink" >&2
  exit 1
fi

if [ -L "$ROOT_DIR/docs" ] || [ -L "$ROOT_DIR/docs/public" ]; then
  echo "public image parent directories must not be symlinks" >&2
  exit 1
fi
for images in "$ROOT_DIR/docs/public/images" "$ROOT_DIR/docs/assets"; do
  if [ -L "$images" ] || { [ -d "$images" ] && [ -n "$(find "$images" -type l -print -quit)" ]; }; then
    echo "public image sources must not contain symlinks" >&2
    exit 1
  fi
done

echo "Sync public README and demo images to ${REPO_URL}"
git clone "$REPO_URL" "$TMP_DIR/repo"

cd "$TMP_DIR/repo"

if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  git checkout "$BRANCH"
elif git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
  git checkout -b "$BRANCH" --track "origin/$BRANCH"
else
  git checkout -b "$BRANCH"
fi

find "$TMP_DIR/repo" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +

install -m 0644 "$ROOT_DIR/README.public.md" "$TMP_DIR/repo/README.md"

if [ -d "$ROOT_DIR/docs/public/images" ]; then
  install -d "$TMP_DIR/repo/docs/images"
  cp -R "$ROOT_DIR/docs/public/images/." "$TMP_DIR/repo/docs/images/"
elif [ -d "$ROOT_DIR/docs/assets" ]; then
  install -d "$TMP_DIR/repo/docs/images"
  cp -R "$ROOT_DIR/docs/assets/." "$TMP_DIR/repo/docs/images/"
fi

while IFS= read -r -d '' deleted; do
  git add -- "$deleted"
done < <(git diff --name-only --no-renames --diff-filter=D -z)
git add -- README.md
if [ -d docs/images ]; then
  git add -- docs/images
fi
if git diff --cached --quiet; then
  echo "No public files to sync"
  exit 0
fi

if [ "$DRY_RUN" = "1" ]; then
  git status --short
  echo "DRY_RUN=1, skip commit and push"
  exit 0
fi

git commit -m "docs: update public package page"
git push -u origin "$BRANCH"
