{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "sourceCommit",
    "target",
    "preconditions",
    "state",
    "decision",
    "steps",
    "executionAuthorized",
    "planHash",
    "sourceHistoryFingerprint",
    "sourceSchemaFingerprint",
    "sourceIdentity",
    "safetyGate",
    "safetyEvidenceFingerprint",
    "sourceEvidenceFingerprint",
    "targetEvidenceFingerprint"
  ],
  "properties": {
    "apiVersion": {
      "const": "sdkit.dev/migration-plan/v1"
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object"
    },
    "preconditions": {
      "type": "object"
    },
    "state": {
      "enum": [
        "equal",
        "local_ahead",
        "remote_ahead",
        "diverged",
        "schema_drift",
        "history_mismatch",
        "checksum_mismatch",
        "unknown"
      ]
    },
    "decision": {
      "const": "blocked"
    },
    "steps": {
      "type": "array"
    },
    "executionAuthorized": {
      "const": false
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHistoryFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSchemaFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceIdentity": {
      "type": "object"
    },
    "safetyGate": {
      "type": "object",
      "required": [
        "status",
        "executionAuthorized",
        "evidenceVerified"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "executionAuthorized": {
          "const": false
        },
        "evidenceVerified": {
          "const": false
        }
      }
    },
    "safetyEvidenceFingerprint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "sourceEvidenceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetEvidenceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
