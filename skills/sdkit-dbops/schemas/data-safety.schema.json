{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "risk",
    "reasons",
    "executionAuthorized"
  ],
  "properties": {
    "status": {
      "enum": [
        "blocked",
        "unknown"
      ]
    },
    "risk": {
      "enum": [
        "destructive",
        "unknown"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executionAuthorized": {
      "const": false
    }
  }
}
