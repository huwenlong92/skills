{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "history",
    "snapshotFingerprint",
    "normalizerVersion",
    "evidence"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "databaseId",
        "dialect",
        "databaseVersion",
        "scope"
      ],
      "properties": {
        "environmentId": {
          "type": "string",
          "minLength": 1
        },
        "databaseId": {
          "type": "string",
          "minLength": 1
        },
        "dialect": {
          "enum": [
            "postgres",
            "mysql",
            "oracle",
            "sqlite"
          ]
        },
        "databaseVersion": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "history": {
      "type": "object"
    },
    "snapshotFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\\\s\\\\S])"
    },
    "normalizerVersion": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "required": [
        "sourceCommit",
        "collector",
        "capturedAt"
      ],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?![\\\\s\\\\S])"
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
