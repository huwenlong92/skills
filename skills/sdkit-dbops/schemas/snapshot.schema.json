{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dialect",
    "databaseVersion",
    "normalizerVersion",
    "scope",
    "coverage",
    "objects"
  ],
  "properties": {
    "dialect": {
      "enum": [
        "postgres",
        "mysql",
        "oracle",
        "sqlite"
      ]
    },
    "databaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "normalizerVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "kinds"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "table",
              "column",
              "index",
              "constraint",
              "sequence",
              "view"
            ]
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "schema",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  }
}
