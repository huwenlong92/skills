{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDKit Migration Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dialect",
    "path",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-f0-9]{6,16}_[a-z][a-z0-9_]*$"
    },
    "dialect": {
      "enum": [
        "postgres",
        "mysql",
        "oracle",
        "sqlite"
      ]
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
