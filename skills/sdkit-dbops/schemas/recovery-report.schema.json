{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "executionAuthorized"
  ],
  "properties": {
    "status": {
      "enum": [
        "investigation_required",
        "reconciled",
        "new_plan_required"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "executionAuthorized": {
      "const": false
    }
  }
}
